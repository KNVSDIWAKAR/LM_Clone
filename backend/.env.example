# Copy to .env and fill in. DATABASE_URL, if set, overrides the DB_* values.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=loss_mitigation
DB_USER=postgres
DB_PASSWORD=
DB_SSLMODE=prefer
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Serve the UI from the API port. On startup the server rebuilds frontend/dist if frontend/ changed
# (needs Node/npm); the watcher keeps rebuilding on edits. In production set both to false and ship a built dist.
FRONTEND_AUTO_BUILD=true
FRONTEND_WATCH=true
# Auto-flow: new cases run through the workflow on their own
AUTO_FLOW_ENABLED=true
AUTO_FLOW_INTERVAL_SECONDS=30
